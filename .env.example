# Dingyue Check environment variables.
# Keep secrets out of commits and issues. Boolean values accept: 1/0, true/false, yes/no, on/off.

# -- Required ---------------------------------------------------------------
# Required. Telegram bot token from @BotFather.
TELEGRAM_BOT_TOKEN=

# Required. Telegram owner/admin user ID. Integer. Default in code: 0.
OWNER_ID=

# -- Common -----------------------------------------------------------------

# Optional. Comma-separated Telegram user IDs allowed to use the bot. Every item must be an integer.
ALLOWED_USER_IDS=

# Optional. Runtime mode: legacy_polling or unified_async. Default: legacy_polling.
APP_RUN_MODE=legacy_polling

# -- Feature flags ----------------------------------------------------------
# Optional. Server profile preset: 256mb, 512mb, or 1gb. Default: 1gb.
SERVER_PROFILE=1gb

# Optional. Enable latency tester. Default depends on SERVER_PROFILE.
ENABLE_LATENCY_TESTER=true

# Optional. Enable scheduled monitoring. Default depends on SERVER_PROFILE.
ENABLE_MONITOR=true

# Optional. Enable geo lookup. Default depends on SERVER_PROFILE.
ENABLE_GEO_LOOKUP=true

# Optional. Verify TLS certificates when downloading subscriptions. Default: true.
VERIFY_SSL=true

# Optional. Keep legacy owner read commands enabled. Default: true.
ENABLE_OWNER_LEGACY_READ_COMMANDS=true

# Optional. Show compact subscription action buttons for users. Default: true.
ENABLE_USER_COMPACT_SUB_BUTTONS=true

# -- Web Admin --------------------------------------------------------------
# Optional. Enable Web Admin. Default: false.
ENABLE_WEB_ADMIN=false

# Optional. Web Admin bind host. Default: 127.0.0.1.
WEB_ADMIN_HOST=127.0.0.1

# Optional integer. Web Admin bind port. Default: 8080.
WEB_ADMIN_PORT=8080

# Required when Web Admin is enabled. Login password and signing secret.
WEB_ADMIN_TOKEN=

# Optional. Public Web Admin URL shown in bot messages.
WEB_ADMIN_PUBLIC_URL=

# Optional. Web Admin username. Default: admin.
WEB_ADMIN_USERNAME=admin

# Optional integer. Session TTL in seconds. Default: 28800.
WEB_ADMIN_SESSION_TTL_SECONDS=28800

# Optional. Allow API access with token header. Default: false.
WEB_ADMIN_ALLOW_HEADER_TOKEN=false

# Optional. Send auth cookie only over HTTPS. Default: true.
WEB_ADMIN_COOKIE_SECURE=true

# Optional. Trust X-Forwarded-For from reverse proxy. Default: false.
WEB_ADMIN_TRUST_PROXY=false

# Optional integer. Login rate-limit window in seconds. Default: 600.
WEB_ADMIN_LOGIN_WINDOW_SECONDS=600

# Optional integer. Max login attempts in the rate-limit window. Default: 10.
WEB_ADMIN_LOGIN_MAX_ATTEMPTS=10

# Optional. Redis URL for Web Admin sessions and login limits. Empty uses memory backend.
WEB_ADMIN_REDIS_URL=

# Optional. Explicitly allow memory fallback when configured Redis is unavailable. Default: false.
WEB_ADMIN_REDIS_ALLOW_MEMORY_FALLBACK=false

# -- Advanced: subscription parsing -----------------------------------------
# Most deployments can keep the advanced defaults below.
# Optional integer. Local proxy port used by legacy helpers. Default: 7890.
PROXY_PORT=7890

# Optional integer. URL cache max entries. Default: 5000.
URL_CACHE_MAX_SIZE=5000

# Optional integer. URL cache TTL in seconds. Default: 86400.
URL_CACHE_TTL_SECONDS=86400

# Optional integer. Max nodes parsed from one subscription. Default depends on SERVER_PROFILE.
MAX_NODES_PER_PARSE=300

# Optional integer. Bytes read for lightweight content detection. Default: 8192.
DETECT_READ_BYTES=8192

# Optional integer. Subscription download timeout in seconds. Default depends on SERVER_PROFILE.
SUB_TIMEOUT=15

# Optional integer. Subscription download worker count. Default: 30.
SUB_DOWNLOAD_WORKERS=30

# Optional. User-Agent for Clash-compatible subscription requests.
UA_CLASH=ClashForAndroid/2.5.12

# Optional. Browser User-Agent fallback for subscription requests.
UA_BROWSER=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36

# -- Parser performance -----------------------------------------------------
# Optional integer. Node latency test concurrency. Default depends on SERVER_PROFILE.
LATENCY_TEST_CONCURRENCY=30

# Optional integer. Geo lookup worker count. Default: 8.
GEO_LOOKUP_MAX_WORKERS=8

# Optional integer. Max geo lookup queries per batch. Default: 50.
MAX_GEO_QUERIES=50

# Optional integer. Global parse concurrency. Default: 24.
PARSE_GLOBAL_CONCURRENCY=24

# Optional integer. Per-user parse concurrency. Default: 6.
PARSE_USER_CONCURRENCY=6

# Optional float. Slow parse log threshold in seconds. Default: 8.
PARSE_SLOW_THRESHOLD_SECONDS=8

# Optional integer. Emit parse stats every N parses. Default: 50.
PARSE_STATS_REPORT_EVERY=50

# Optional integer. Successful parse cache TTL in seconds. Default: 12.
PARSE_SUCCESS_CACHE_TTL_SECONDS=12

# Optional integer. Successful parse cache max entries. Default: 512.
PARSE_SUCCESS_CACHE_MAX_SIZE=512

# -- Latency tester ---------------------------------------------------------
# Optional integer. Node test timeout in milliseconds. Default: 6000.
TIMEOUT_MS=6000

# Optional integer. Mihomo controller API port. Default: 19090.
API_PORT=19090

# Optional. URL used for connectivity tests.
TEST_URL=http://www.gstatic.com/generate_204

# Optional integer. Number of top proxies shown in reports. Default: 10.
PROXY_TOP_N=10

# Optional. Print verbose node test logs. Default: false.
NODE_TEST_VERBOSE=false

# -- Owner aggregate subscription ------------------------------------------
# Optional float. Quick node test timeout in seconds. Default: 1.5.
OWNER_AGGREGATE_NODE_TEST_TIMEOUT_SECONDS=1.5

# Optional integer. Quick node test concurrency. Default: 40.
OWNER_AGGREGATE_NODE_TEST_CONCURRENCY=40

# Optional integer. Max nodes selected per source before testing. Default: 24.
OWNER_AGGREGATE_SOURCE_LIMIT=24

# Optional integer. Max candidate nodes per aggregate build. Default: 180.
OWNER_AGGREGATE_CANDIDATE_LIMIT=180

# Optional integer. Max published aggregate nodes. Default: 120.
OWNER_AGGREGATE_PUBLISH_LIMIT=120

# Optional integer. Quick health cache TTL in seconds. Default: 1800.
OWNER_AGGREGATE_NODE_QUICK_TTL_SECONDS=1800

# Optional integer. Verified health cache TTL in seconds. Default: 21600.
OWNER_AGGREGATE_NODE_VERIFY_TTL_SECONDS=21600

# Optional. Enable Mihomo verification pass. Default: true.
OWNER_AGGREGATE_VERIFY_ENABLED=1

# Optional integer. Max nodes verified by Mihomo per build. Default: 30.
OWNER_AGGREGATE_VERIFY_LIMIT=30

# Optional integer. Mihomo verify timeout in milliseconds. Default: 3500.
OWNER_AGGREGATE_VERIFY_TIMEOUT_MS=3500

# Optional integer. Success streak needed for stable pool. Default: 2.
OWNER_AGGREGATE_STABLE_SUCCESS_THRESHOLD=2

# Optional integer. Failure streak needed to evict dead nodes. Default: 2.
OWNER_AGGREGATE_EVICT_FAILURE_THRESHOLD=2

# Optional integer. Background prewarm interval in seconds. Default: 180.
OWNER_AGGREGATE_PREWARM_INTERVAL_SECONDS=180

# Optional integer. Stable nodes reverified per build. Default: 12.
OWNER_AGGREGATE_STABLE_REVERIFY_LIMIT=12

# Optional integer. Max published nodes from one source. Default: 12.
OWNER_AGGREGATE_PUBLISH_SOURCE_LIMIT=12

# Optional integer. Max published nodes from one server. Default: 3.
OWNER_AGGREGATE_PUBLISH_SERVER_LIMIT=3

# Optional integer. Minimum prewarm sleep in seconds. Default: 60.
OWNER_AGGREGATE_PREWARM_MIN_SECONDS=60

# Optional integer. Maximum prewarm sleep in seconds. Default: 300.
OWNER_AGGREGATE_PREWARM_MAX_SECONDS=300

# Optional integer. Stable pool target percentage. Default: 70.
OWNER_AGGREGATE_POOL_STABLE_RATIO=70

# Optional integer. Warm pool target percentage. Default: 20.
OWNER_AGGREGATE_POOL_WARM_RATIO=20

# Optional integer. Fresh pool target percentage. Default: 10.
OWNER_AGGREGATE_POOL_FRESH_RATIO=10

# Optional integer. Health score decay window in seconds. Default: 21600.
OWNER_AGGREGATE_HEALTH_DECAY_WINDOW_SECONDS=21600

# -- Maintenance ------------------------------------------------------------
# Optional integer. Log retention in days. Default: 30.
LOG_KEEP_DAYS=30
